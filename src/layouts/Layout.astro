---
import '@fontsource/anton/400.css';
import '@fontsource/fira-sans/100.css';
import '@fontsource/fira-sans/100-italic.css';
import '@fontsource/fira-sans/400.css';
import '@fontsource/fira-sans/600.css';
import '@fontsource/fira-sans/700.css';
import '../styles/main.css';
import antonWoff2 from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import firaWoff2 from '@fontsource/fira-sans/files/fira-sans-latin-400-normal.woff2?url';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageTransition from '../components/PageTransition.astro';

interface Props {
    title?: string;
    description?: string;
}

const defaultTitle = 'Juan Sebastian | Developer';
const { title = defaultTitle, description = 'Portfolio y blog de Juan Sebastian, graphics programmer de Colombia.' } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site);
---
<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <script is:inline>
            try {
                var nav = performance.getEntriesByType('navigation')[0];
                var leftKey = 'pt-left:' + location.pathname;
                // Animate a back/forward arrival only if this page was left through the curtain.
                if (!sessionStorage.getItem('pt-state') && nav && nav.type === 'back_forward' && sessionStorage.getItem(leftKey)) {
                    sessionStorage.setItem('pt-state', JSON.stringify({ label: '', dir: 'up' }));
                }
                sessionStorage.removeItem(leftKey);
                if (sessionStorage.getItem('pt-state')) {
                    document.documentElement.classList.add('pt-enter');
                    // Failsafe: if the transition script never runs, don't leave the page covered.
                    setTimeout(function () { document.documentElement.classList.remove('pt-enter'); }, 4000);
                }
            } catch (e) {}
        </script>
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="preload" href={antonWoff2} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={firaWoff2} as="font" type="font/woff2" crossorigin />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="icon" href="/img/favicon-32.png" type="image/png" sizes="32x32" />
        <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
        <meta name="theme-color" content="#0a0a0a" />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content="Juan Sebastian" />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL('/img/og-image.png', Astro.site)} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <slot name="head" />
    </head>
    <body class="bg-neutral-950">
        <div>
            <Navbar />
            <slot />
            <Footer />
            <PageTransition />
        </div>
    </body>
</html>
