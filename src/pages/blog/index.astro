---
import Layout from '../../layouts/Layout.astro';
import { getPosts, formatDate } from '../../lib/blog';

const posts = await getPosts();
---
<Layout title="Blog | Juan Sebastian">
    <div class="w-full flex flex-col items-center px-6 md:px-8 pb-16 min-h-[70vh]">
        <div class="pt-32 pb-8">
            <h1 class="text-white font-fira text-5xl">Blog</h1>
        </div>

        {posts.length === 0 ? (
            <div class="flex flex-col items-center gap-4 py-16 text-center">
                <p class="font-anton uppercase text-4xl md:text-5xl text-white tracking-wide">Próximamente</p>
                <p class="font-fira text-lg text-gray-400 max-w-md">Todavía no hay posts publicados. Vuelve pronto.</p>
            </div>
        ) : (
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl w-full">
                {posts.map((post, index) => (
                    <a
                        href={`/blog/${post.id}`}
                        data-transition="Blog"
                        class:list={['group px-4 py-4 bg-neutral-950 hover:bg-neutral-900 h-fit rounded-2xl flex flex-col transition', index === 0 && 'lg:col-span-2']}
                    >
                        {post.data.image ? (
                            <img class:list={['rounded-2xl object-cover w-full', index === 0 ? 'lg:max-h-[512px]' : 'max-h-72']} src={post.data.image} alt="" loading={index === 0 ? 'eager' : 'lazy'} />
                        ) : (
                            <div class:list={['rounded-2xl w-full bg-[radial-gradient(ellipse_at_bottom,#dc2626_0%,#5e165e_55%,#0a0a0a_100%)] flex items-center justify-center px-6', index === 0 ? 'h-64 lg:h-80' : 'h-48']} aria-hidden="true">
                                <span class="font-anton uppercase text-white text-4xl md:text-5xl text-center drop-shadow-[0_4px_0_#0a0a0a] transition-transform duration-300 group-hover:scale-105">{post.data.title}</span>
                            </div>
                        )}
                        <div class="px-4 md:px-8 flex flex-col py-4 space-y-3">
                            <span class:list={['pt-2 font-fira text-white font-semibold', index === 0 ? 'lg:text-4xl text-3xl' : 'text-3xl']}>{post.data.title}</span>
                            <div class="flex items-center gap-2 text-gray-400 font-fira text-sm">
                                <img width="24" height="24" class="rounded-full border-2 border-sky-600" alt="" src="/img/profile.webp" />
                                <span class="text-white">Juan Sebastian</span>
                                <span aria-hidden="true">·</span>
                                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                            </div>
                            <p class="font-fira font-thin text-gray-200 text-lg">{post.data.description}</p>
                        </div>
                    </a>
                ))}
            </div>
        )}
    </div>
</Layout>
