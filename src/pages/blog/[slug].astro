---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getPosts, formatDate, type Post } from '../../lib/blog';

export const getStaticPaths = (async () => {
    const posts = await getPosts();
    return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
---
<Layout title={`${post.data.title} | Juan Sebastian`} description={post.data.description}>
    <div class="min-h-screen bg-neutral-950 text-white flex flex-col">
        <!-- Cover -->
        <div class="absolute inset-0 w-full h-[70vh] overflow-hidden">
            {post.data.image ? (
                <img src={post.data.image} alt="" class="absolute inset-0 w-full h-full object-cover" />
            ) : (
                <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,#dc2626_0%,#5e165e_45%,#0a0a0a_85%)]" aria-hidden="true"></div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 from-10% via-neutral-950/80 via-50% to-90% to-neutral-950/40"></div>
        </div>

        <!-- Title -->
        <header class="relative max-w-3xl mx-auto text-center px-4 pt-32 pb-8">
            <h1 class="text-4xl md:text-5xl font-fira mb-4">{post.data.title}</h1>
            <div class="flex justify-center items-center gap-3 mb-4 text-sm">
                <img width="36" height="36" class="rounded-full border-2 border-sky-600" alt="" src="/img/profile.webp" />
                <span class="font-thin">Juan Sebastian</span>
                <span aria-hidden="true">·</span>
                <time class="font-thin text-gray-300" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            </div>
            <p class="text-lg font-fira font-thin italic text-gray-300">{post.data.description}</p>
        </header>

        <!-- Article -->
        <article class="prose-post relative mt-[30vh] w-full px-6 pt-12 pb-12 bg-neutral-950 max-w-4xl mx-auto font-fira">
            <Content />
        </article>
    </div>

    <div id="toast" role="status" aria-live="polite" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 rounded-[10px] bg-[#333] text-white px-4 py-2 shadow-lg opacity-0 pointer-events-none transition-opacity duration-200">
        📋 Enlace copiado
    </div>
</Layout>

<script>
    // Click a heading to copy a link to it.
    const toast = document.getElementById('toast')!;
    let timer: ReturnType<typeof setTimeout> | undefined;

    document.querySelectorAll<HTMLElement>('.prose-post :is(h1, h2, h3)[id]').forEach((heading) => {
        heading.addEventListener('click', () => {
            const url = `${location.origin}${location.pathname}#${heading.id}`;
            navigator.clipboard.writeText(url).then(() => {
                toast.classList.remove('opacity-0');
                clearTimeout(timer);
                timer = setTimeout(() => toast.classList.add('opacity-0'), 2000);
            }, () => {});
        });
    });
</script>
