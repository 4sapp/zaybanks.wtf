---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import { githubHref } from '../lib/contact';

---
<Layout>
    <div class="min-h-[calc(100vh-16rem)] flex items-center justify-center px-4 pt-28">
        <div class="z-10 flex flex-col items-center space-y-8">

            <div class="flex flex-col lg:flex-row justify-center items-center lg:space-x-8 space-y-6 lg:space-y-0 hover:cursor-default">
                <img
                    alt="Juan Sebastian"
                    class="rounded-full border-4 border-zinc-500 object-cover w-48 h-48 md:w-64 md:h-64 lg:w-[250px] lg:h-[250px]"
                    src="/img/profile.webp"
                />

                <div class="flex flex-col space-y-4 items-center lg:items-start">
                    <h1 class="text-white text-4xl md:text-5xl font-semibold text-center lg:text-left">
                        👋 Hi Everyone!
                    </h1>

                    <h1 class="text-white text-2xl md:text-3xl flex flex-row flex-wrap justify-center lg:justify-start">
                        I'm&nbsp;<span class="text-gray-400">Juan Sebastian</span>
                    </h1>

                    <div class="flex flex-row items-center space-x-4 flex-wrap justify-center lg:justify-start">
                        <Icon name="desktop" class="text-3xl md:text-4xl text-blue-500" />
                        <div class="flex flex-col text-white font-semibold text-lg md:text-xl items-center">
                            <p>Graphics</p>
                            <p>Programmer</p>
                        </div>

                        <Icon name="earth-americas" class="text-3xl md:text-4xl text-rose-600" />
                        <div class="flex flex-col text-white font-semibold text-lg md:text-xl items-center">
                            <p>Colombia</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="relative z-20 flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4 w-full max-w-xl justify-center">
                <a
                    href={githubHref}
                    class="py-3 md:py-4 px-6 md:px-8 rounded bg-gray-800 text-white font-semibold text-lg md:text-xl flex items-center justify-center space-x-2 border border-gray-900 hover:bg-white hover:text-black transition"
                >
                    <Icon name="github" />
                    <p>GitHub</p>
                </a>

                <a
                    href="/portfolio"
                    data-transition="Portfolio"
                    class="py-3 md:py-4 px-6 md:px-8 rounded bg-orange-800 text-white font-semibold text-lg md:text-xl flex items-center justify-center space-x-2 border border-orange-900 hover:bg-white hover:text-orange-800 transition"
                >
                    <Icon name="diagram-project" />
                    <p>Portfolio</p>
                </a>
            </div>

        </div>
    </div>
</Layout>
