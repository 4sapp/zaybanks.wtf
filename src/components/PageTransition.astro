---
/**
 * Curtain transition in the style of the menu (purple + red panels).
 *
 *   <a href="/x" data-transition="Label">                      → curtain falls (forward)
 *   <a href="/x" data-transition="Label" data-transition-dir="up"> → curtain rises (going back)
 *
 * The next page starts covered and reveals itself in the same direction.
 * Browser back/forward navigation also plays the "up" reveal.
 */
---
<div id="pt" aria-hidden="true" class="pointer-events-none fixed inset-0 z-[60] overflow-hidden">
    <div data-pt-back class="absolute inset-0 bg-[#5e165e]" style="transform: translateY(-100%)"></div>
    <div data-pt-front class="absolute inset-0 flex items-center justify-center bg-red-900" style="transform: translateY(-100%)">
        <span class="block overflow-hidden px-4">
            <span data-pt-label class="block font-anton uppercase text-white text-6xl sm:text-8xl md:text-[10rem] leading-none"></span>
        </span>
    </div>
</div>

<style is:global>
    /* Set by the inline head script when arriving from a transition: start covered (no flash). */
    html.pt-enter #pt [data-pt-back],
    html.pt-enter #pt [data-pt-front] {
        transform: translateY(0) !important;
    }
</style>

<script>
    import { gsap } from 'gsap';

    type Dir = 'down' | 'up';
    interface State { label: string; dir: Dir }

    const KEY = 'pt-state';
    const root = document.getElementById('pt')!;
    const back = root.querySelector<HTMLElement>('[data-pt-back]')!;
    const front = root.querySelector<HTMLElement>('[data-pt-front]')!;
    const label = root.querySelector<HTMLElement>('[data-pt-label]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let busy = false;
    let leftCovered = false;

    const store = {
        get(): State | null {
            try { const v = sessionStorage.getItem(KEY); return v ? JSON.parse(v) : null; } catch { return null; }
        },
        set(v: State) { try { sessionStorage.setItem(KEY, JSON.stringify(v)); } catch { /* ignore */ } },
        clear() { try { sessionStorage.removeItem(KEY); } catch { /* ignore */ } },
    };

    const hidden = () => {
        gsap.killTweensOf([back, front, label]);
        gsap.set([back, front], { y: 0, yPercent: -100 });
        root.classList.add('pointer-events-none');
        document.documentElement.classList.remove('pt-enter');
        busy = false;
    };

    /** Curtain is fully down: slide it away in the given direction. */
    /** Resolve when fonts and above-the-fold images are ready, but never wait more than `max` ms. */
    const pageReady = (max = 700) => {
        const imgs = Array.from(document.images)
            .filter((img) => !img.complete && img.getBoundingClientRect().top < window.innerHeight)
            .map((img) => new Promise((r) => { img.addEventListener('load', r, { once: true }); img.addEventListener('error', r, { once: true }); }));
        return Promise.race([
            Promise.all([document.fonts?.ready, ...imgs]),
            new Promise((r) => setTimeout(r, max)),
        ]);
    };

    const reveal = ({ label: text, dir }: State, delay = 0.15) => {
        label.textContent = text;
        gsap.killTweensOf([back, front, label]);
        gsap.set([back, front], { y: 0, yPercent: 0 });
        gsap.set(label, { yPercent: 0 });
        document.documentElement.classList.remove('pt-enter');
        if (reduced) return hidden();

        const out = dir === 'up' ? -100 : 100;
        const tl = gsap.timeline({ onComplete: hidden, delay });
        if (text) tl.to(label, { yPercent: dir === 'up' ? 110 : -110, duration: 0.35, ease: 'power2.in' });
        tl.to(front, { yPercent: out, duration: 0.55, ease: 'power3.inOut' }, text ? '-=0.1' : 0)
          .to(back, { yPercent: out, duration: 0.5, ease: 'power3.inOut' }, '-=0.4');
    };

    /** Bring the curtain down from the given side, then run `done`. */
    const cover = ({ label: text, dir }: State, done: () => void) => {
        if (reduced) return done();
        busy = true;
        label.textContent = text;
        root.classList.remove('pointer-events-none');
        const from = dir === 'up' ? 100 : -100;
        gsap.timeline({ onComplete: done })
            .fromTo(back, { y: 0, yPercent: from }, { yPercent: 0, duration: 0.4, ease: 'power2.out' })
            .fromTo(front, { y: 0, yPercent: from }, { yPercent: 0, duration: 0.5, ease: 'power2.out' }, '-=0.2')
            .fromTo(label, { yPercent: dir === 'up' ? -110 : 110 }, { yPercent: 0, duration: 0.45, ease: 'power3.out' }, '-=0.15');
    };

    // ----- Arrival -----
    const incoming = store.get();
    store.clear();
    if (incoming) {
        // Keep it covered (inline transform) while waiting; the !important class is dropped in reveal().
        gsap.set([back, front], { y: 0, yPercent: 0 });
        label.textContent = incoming.label;
        pageReady().then(() => reveal(incoming, 0.05));
    } else {
        gsap.set([back, front], { y: 0, yPercent: -100 }); // normalise the inline translateY(-100%)
    }

    // ----- Departure -----
    document.addEventListener('click', (e) => {
        const link = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[data-transition]');
        if (!link || busy) return;
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (link.target && link.target !== '_self') return;
        e.preventDefault();

        const url = new URL(link.href, location.href);
        const samePage = url.origin === location.origin
            && url.pathname.replace(/\/+$/, '') === location.pathname.replace(/\/+$/, '')
            && url.search === location.search;
        if (samePage) {
            document.dispatchEvent(new CustomEvent('menu:close'));
            if (url.hash) location.hash = url.hash;
            else window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
            return;
        }

        const state: State = {
            label: link.dataset.transition || '',
            dir: link.dataset.transitionDir === 'up' ? 'up' : 'down',
        };
        store.set(state);
        leftCovered = true;
        try { sessionStorage.setItem('pt-left:' + location.pathname, '1'); } catch { /* ignore */ }
        cover(state, () => { window.location.href = link.href; });
    });

    // ----- Browser back/forward restored from cache -----
    window.addEventListener('pageshow', (e) => {
        if (!e.persisted) return;
        store.clear();
        try { sessionStorage.removeItem('pt-left:' + location.pathname); } catch { /* ignore */ }
        if (leftCovered) reveal({ label: '', dir: 'up' }, 0.05);
        else hidden();
        leftCovered = false;
    });
</script>
